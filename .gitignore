# Keeps out everything that is not code, notebooks, figures, the saved
# per-patch predictions or the synthetic data generator.
#
# The leading slashes matter. A bare `data/` matches a directory called `data`
# at ANY depth, which silently excluded `vmlevaluator/data/` -- the package's
# own data-loading module -- from the first commit, leaving a repository that
# could not be imported. Anchor anything that is meant to mean "the one at the
# top level".
#
# The trained weights ARE committed (630 MB across 21 files). The largest is
# 92.0 MiB, under GitHub's 100 MiB hard limit, so no Git LFS is needed -- the
# six ResNet-50 checkpoints do trip the 50 MB warning, which is only a warning.
#
# /data/ holds histology that is not distributable, and the human predictions
# carry study codes -- see RELEASING.md before pushing.

# Histology and workbooks (the top-level folder only)
/data/

# The ImageNet checkpoint ResNet-50 starts from: ~100 MB, and timm downloads it
# automatically, so there is nothing to gain by committing it.
/pretrained/

# Generated stand-in data and everything a re-run writes
/data_synthetic/
/runs/

# Notebook state -- notebooks/ is committed clean, notebooks/executed with outputs
.ipynb_checkpoints/

# Python (these are meant to match at any depth)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
/build/
/dist/
/.venv/
/venv/

# OS
.DS_Store
Thumbs.db
